# Copy values into your deployment environment; do not commit real credentials.
LIVE_SOURCES_PATH=live_sources.json
LIVE_USER_AGENT=Chronicle/1.0 (financial research; operations@example.org)
LIVE_REFRESH_ON_QUERY=true
MEMORY_ENABLED=true
MEMORY_RETENTION_DAYS=30

# SEC EDGAR requires a real, concise User-Agent identifying the requester
# (https://www.sec.gov/os/webmaster-faq#developers) — override with your own
# contact identity before running this against SEC EDGAR in your own
# deployment. A verbose/instructional string gets HTTP 403 from SEC's bot
# detection (verified empirically); keep it short: "AppName/Version (email)".
EDGAR_USER_AGENT=YourApp/1.0 (you@example.org)
# Self-imposed floor on request spacing, well under SEC's stated ceiling.
EDGAR_MIN_REQUEST_INTERVAL_SECONDS=0.34

# In production, mount these paths on encrypted persistent storage.
# LIVE_STATE_DB_PATH=/secure-data/live_state.sqlite3
# MEMORY_DB_PATH=/secure-data/memory.sqlite3
